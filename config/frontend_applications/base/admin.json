{
  "schema_version": 1,
  "id": "admin",
  "product_owner": "ce",
  "runtime_owner": "ce",
  "runtime_kind": "inertia",
  "entrypoint": "admin",
  "landing_path": "/admin",
  "component_prefixes": [
    "Admin/ArcoDemo/",
    "Admin/AuditLogs/",
    "Admin/Dashboard/",
    "Admin/Forum/",
    "Admin/Frontend/",
    "Admin/Generic/",
    "Admin/Minecraft/",
    "Admin/Plugins/",
    "Admin/Roles/",
    "Admin/Store/",
    "Admin/System/",
    "Admin/Users/",
    "Admin/Website/"
  ],
  "component_names": ["Admin/DashboardProDemo"],
  "allow_descendant_contributions": true,
  "projections": [],
  "shell_adapter": "admin",
  "ui_adapter": "mcweb_ui",
  "styles": ["tokens", "shell_foundation", "arco_admin", "admin"],
  "locales": ["core", "admin"],
  "error_boundary": "admin",
  "capabilities": ["locale", "theme", "session", "dirty_forms", "developer_persona", "secure_evidence"],
  "budget": {
    "representative_paths": ["/admin", "/admin/users", "/admin/system/settings"],
    "representative_components": ["Admin/Dashboard/Index", "Admin/Generic/Index", "Admin/System/Settings/Show"],
    "max_initial_javascript_bytes": 850000,
    "max_initial_stylesheet_bytes": 330000
  },
