#!/usr/bin/env bash
set -euo pipefail

APP_NAME="mcweb"
APP_USER="mcweb"
APP_ROOT="/opt/mcweb"
CONFIG_DIR="/etc/mcweb"
DATA_DIR="/var/lib/mcweb"
LOG_DIR="/var/log/mcweb"
BACKUP_DIR="/var/backups/mcweb"
RUBY_VERSION="4.0.6"
NGINX_SITE="/etc/nginx/sites-available/mcweb"
NGINX_TEMPLATE="config/templates/mcweb.nginx.conf"
ACME_WEBROOT="/var/www/certbot"
ENV_FILE_CREATED=0

usage() {
  cat <<EOF
McWeb 安装程序

用法:
  bin/install                 交互式安装
  bin/install --unattended    无人值守安装（读取 /etc/mcweb/install.env）

环境变量配置文件示例见 config/templates/install.env.example
EOF
}

require_root() {
  if [[ "${EUID}" -ne 0 ]]; then
    echo "请使用 root 或 sudo 运行安装程序" >&2
    exit 1
  fi
}

detect_os() {
  if [[ -f /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    echo "${ID}"
  else
    echo "unknown"
  fi
}

install_postgresql() {
  local pg_version="${MCWEB_POSTGRESQL_VERSION:-18}"

  apt-get install -y -qq curl ca-certificates gnupg lsb-release
  install -d /usr/share/postgresql-common/pgdg
  if [[ ! -f /etc/apt/sources.list.d/pgdg.list ]]; then
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o /tmp/pgdg.asc
    gpg --batch --yes --dearmor -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg < /tmp/pgdg.asc
    echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.gpg] https://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" > /etc/apt/sources.list.d/pgdg.list
    apt-get update -qq
  fi

  DEBIAN_FRONTEND=noninteractive apt-get install -y \
    "postgresql-${pg_version}" \
    "postgresql-client-${pg_version}"
}

install_dependencies() {
  local os
  os="$(detect_os)"
  case "$os" in
    ubuntu|debian)
      apt-get update -qq
      DEBIAN_FRONTEND=noninteractive apt-get install -y \
        build-essential libpq-dev libyaml-dev libssl-dev zlib1g-dev \
        libvips-dev imagemagick curl git nginx certbot python3-certbot-nginx openssl nodejs
      install_postgresql
      ;;
    *)
      echo "不支持的操作系统: $os" >&2
      exit 1
      ;;
  esac
}

install_ruby() {
  if ! id -u "${APP_USER}" >/dev/null 2>&1; then
    useradd --system --create-home --home-dir "/home/${APP_USER}" --shell /bin/bash "${APP_USER}"
  fi

  sudo -u "${APP_USER}" bash -lc "
    if ! command -v rbenv >/dev/null; then
      git clone https://github.com/rbenv/rbenv.git ~/.rbenv
      git clone https://github.com/rbenv/ruby-build.git ~/.rbenv/plugins/ruby-build
    fi
    export PATH=\"\$HOME/.rbenv/bin:\$HOME/.rbenv/shims:\$PATH\"
    eval \"\$(rbenv init - bash)\"
    rbenv install -s ${RUBY_VERSION}
    rbenv global ${RUBY_VERSION}
    gem install bundler --no-document
  "
}

deploy_release() {
  local version
  version="$(date +%Y%m%d%H%M%S)"
  local release_dir="${APP_ROOT}/releases/${version}"
  mkdir -p "${release_dir}" "${CONFIG_DIR}" "${DATA_DIR}/uploads" "${DATA_DIR}/templates" "${LOG_DIR}" "${BACKUP_DIR}"
  rsync -a --exclude='.git' --exclude='tmp' --exclude='log' --exclude='node_modules' --exclude='storage' --exclude='vendor/bundle' "$(pwd)/" "${release_dir}/"
  ln -sfn "${release_dir}" "${APP_ROOT}/current"
  chown -R "${APP_USER}:${APP_USER}" "${APP_ROOT}" "${DATA_DIR}" "${LOG_DIR}"
}

configure_app() {
  local env_file="${CONFIG_DIR}/mcweb.env"
  if [[ ! -f "${env_file}" ]]; then
    install -m 600 config/templates/mcweb.env.example "${env_file}"
    ENV_FILE_CREATED=1
    echo "已生成 ${env_file}。请替换所有生产配置占位值后重新运行 bin/install。"
  fi
  grep -q '^RAILS_SERVE_STATIC_FILES=' "${env_file}" || echo 'RAILS_SERVE_STATIC_FILES=1' >> "${env_file}"
  grep -q '^BUNDLE_WITHOUT=' "${env_file}" || echo 'BUNDLE_WITHOUT=development:test' >> "${env_file}"
  grep -q '^BUNDLE_DEPLOYMENT=' "${env_file}" || echo 'BUNDLE_DEPLOYMENT=true' >> "${env_file}"
}

write_systemd_units() {
  install -m 644 config/templates/mcweb-web.service /etc/systemd/system/mcweb-web.service
  install -m 644 config/templates/mcweb-worker.service /etc/systemd/system/mcweb-worker.service
  systemctl daemon-reload
}

make_selfsigned() {
  # Throwaway self-signed cert so nginx can boot before the real Let's Encrypt
  # certificate exists (its 443 server block references the cert at startup).
  local domain="$1" dir="/etc/letsencrypt/live/$1"
  install -d -m 755 "${dir}"
  openssl req -x509 -nodes -newkey rsa:2048 -days 1 \
    -keyout "${dir}/privkey.pem" -out "${dir}/fullchain.pem" \
    -subj "/CN=${domain}" >/dev/null 2>&1 || true
}

request_certificate() {
  local domain="$1" email="${MCWEB_ACME_EMAIL:-}"
  local email_arg="--register-unsafely-without-email"
  [[ -n "${email}" ]] && email_arg="--email ${email}"

  # certbot already manages this domain -> renewals handled by certbot.timer.
  if [[ -f "/etc/letsencrypt/renewal/${domain}.conf" ]]; then
    echo "certbot 已管理 ${domain} 证书，续期交由 certbot.timer。"
    systemctl enable certbot.timer >/dev/null 2>&1 || true
    return 0
  fi

  # Bootstrap: nginx will not start while 443 points at a missing cert, and the
  # HTTP-01 challenge needs nginx already serving :80. Break the cycle with a
  # temporary self-signed cert, start nginx, then let certbot replace it.
  make_selfsigned "${domain}"
  systemctl enable nginx >/dev/null 2>&1 || true
  if nginx -t; then
    systemctl reload nginx 2>/dev/null || systemctl restart nginx || true
  fi

  # Drop the throwaway lineage so certbot writes a clean one.
  rm -rf "/etc/letsencrypt/live/${domain}" \
         "/etc/letsencrypt/archive/${domain}" \
         "/etc/letsencrypt/renewal/${domain}.conf"

  echo "申请 Let's Encrypt 证书 (${domain})…"
  # shellcheck disable=SC2086
  if certbot certonly --webroot -w "${ACME_WEBROOT}" -d "${domain}" \
       ${email_arg} --agree-tos --non-interactive --keep-until-expiring \
       --deploy-hook "systemctl reload nginx"; then
    systemctl reload nginx 2>/dev/null || true
    echo "证书申请成功，HTTPS 已启用。"
  else
    make_selfsigned "${domain}"   # keep nginx bootable after a failed request
    systemctl reload nginx 2>/dev/null || true
    echo "⚠ 证书申请失败（常见原因：${domain} 未解析到本机、80/443 端口未放行）。" >&2
    echo "  HTTP 已可用（HTTPS 暂用临时自签证书，浏览器会告警）。解析域名并放行端口后，" >&2
    echo "  重跑 bin/install，或手动执行：" >&2
    echo "  sudo certbot certonly --webroot -w ${ACME_WEBROOT} -d ${domain} ${email_arg} --agree-tos --deploy-hook 'systemctl reload nginx'" >&2
  fi
  systemctl enable certbot.timer >/dev/null 2>&1 || true
}

write_nginx_conf() {
  local domain="${MCWEB_DOMAIN:-}"
  install -d -m 755 "${ACME_WEBROOT}"

  if [[ -z "${domain}" ]]; then
    echo "未设置 MCWEB_DOMAIN，跳过 nginx 站点与证书自动配置。" >&2
    echo "配置域名后：把 ${NGINX_TEMPLATE} 中的 example.com 替换为域名，复制到 ${NGINX_SITE}，" >&2
    echo "ln 到 /etc/nginx/sites-enabled/，再运行 certbot 申请证书。" >&2
    return 0
  fi

  sed "s/example\.com/${domain}/g" "${NGINX_TEMPLATE}" > "${NGINX_SITE}"
  ln -sfn "${NGINX_SITE}" /etc/nginx/sites-enabled/mcweb
  rm -f /etc/nginx/sites-enabled/default   # stop the stock site shadowing ours

  request_certificate "${domain}"

  if nginx -t; then
    systemctl reload nginx 2>/dev/null || systemctl restart nginx || true
  else
    echo "nginx 配置校验失败，请检查 ${NGINX_SITE}。" >&2
  fi
}

main() {
  require_root

  local unattended=0
  for arg in "$@"; do
    case "$arg" in
      --unattended) unattended=1 ;;
      -h|--help) usage; exit 0 ;;
    esac
  done

  if [[ "${unattended}" -eq 1 ]]; then
    local install_env="/etc/mcweb/install.env"
    if [[ ! -f "${install_env}" ]]; then
      echo "缺少 ${install_env}，请先复制 config/templates/install.env.example" >&2
      exit 1
    fi
    # shellcheck disable=SC1090
    source "${install_env}"
  fi

  install_dependencies
  install_ruby
  deploy_release
  configure_app
  write_systemd_units
  write_nginx_conf

  if [[ "${ENV_FILE_CREATED}" -eq 1 ]]; then
    echo "安装已暂停：生产启动会严格校验公网 URL、SMTP 与私有对象存储。"
    echo "编辑 ${CONFIG_DIR}/mcweb.env 后重新运行 bin/install 以完成数据库和资源构建。"
    exit 2
  fi

  systemd-run --quiet --wait --collect --pipe \
    --unit=mcweb-setup \
    --property="Type=oneshot" \
    --property="User=${APP_USER}" \
    --property="WorkingDirectory=${APP_ROOT}/current" \
    --property="EnvironmentFile=${CONFIG_DIR}/mcweb.env" \
    /bin/bash -lc "
      export PATH=\"\$HOME/.rbenv/bin:\$HOME/.rbenv/shims:\$PATH\"
      eval \"\$(rbenv init - bash)\"
      npm ci
      bin/setup
    "

  echo "安装完成。请访问 https://\${MCWEB_DOMAIN:-your-domain}/setup 完成初始化。"
  echo "服务启动: systemctl enable --now mcweb-web mcweb-worker nginx"
}

main "$@"
