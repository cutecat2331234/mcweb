<!DOCTYPE html>
<html
  lang="<%= I18n.locale %>"
  data-developer-mode="<%= Mcweb::DeveloperMode.enabled? %>"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title inertia><%= "[DEV] " if Mcweb::DeveloperMode.enabled? %>Mcweb Admin</title>
    <% if Mcweb::DeveloperMode.enabled? %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/admin_pwa_guard" %>
    <%= render "shared/tech_fingerprint" %>
    <%= vite_typescript_tag "admin" %>
    <%= inertia_ssr_head %>
    <script>
      (function () {
        var key = "mc-theme";
        var stored = localStorage.getItem(key);
        var theme = stored || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        if (theme === "dark") document.documentElement.classList.add("dark");
      })();
    </script>
  </head>
  <body class="antialiased">
    <%= inertia_root %>
  </body>
</html>
