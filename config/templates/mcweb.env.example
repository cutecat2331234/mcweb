# McWeb production environment
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=1
# 由 Puma 提供 /assets 静态文件（nginx 仅反向代理时必需）
RAILS_SERVE_STATIC_FILES=1
# 生产环境使用 vendor/bundle 部署（发布包已内置 gems）
BUNDLE_DEPLOYMENT=true
BUNDLE_WITHOUT=development:test
# 公开技术栈指纹，便于 Wappalyzer 等工具识别 Ruby on Rails（设为 0 可关闭）
MCWEB_PUBLIC_TECH_STACK=1
# Developer Mode 默认关闭。只有受控应急调试才可改为 1；production 同时要求
# 下一行注释中的精确确认短语，普通 true/yes 不会通过。
MCWEB_DEVELOPER_MODE=0
# MCWEB_DEVELOPER_MODE_PRODUCTION_CONFIRMATION=I_ACCEPT_UNSAFE_DEVELOPER_MODE
MCWEB_DATABASE_USERNAME=mcweb
MCWEB_DATABASE_PASSWORD=change_me
MCWEB_DATABASE_NAME=mcweb_production
# 留空则使用 Unix socket（同机 peer 认证）；远程 PostgreSQL 时填写主机名
MCWEB_DATABASE_HOST=
# 非默认端口时填写，例如 5433
MCWEB_DATABASE_PORT=
SECRET_KEY_BASE=generate_with_rails_secret
LOCKBOX_MASTER_KEY=generate_64_hex_chars

# 生产公网地址必须是 HTTPS origin，不能包含路径、查询参数或示例域名。
MCWEB_PUBLIC_URL=https://community.example.com
# Host 白名单只接受逗号分隔的精确域名/IP，不接受通配符。
MCWEB_ALLOWED_HOSTS=community.example.com
# 仅信任实际反向代理的 IP/CIDR。systemd + 本机 nginx 使用以下默认值。
MCWEB_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# Puma 默认只监听回环地址，禁止绕过 TLS 代理直接访问。
MCWEB_BIND=127.0.0.1
# 旧组件兼容项，应与 MCWEB_PUBLIC_URL 的 host 保持一致。
MCWEB_HOST=community.example.com

# SMTP 与统一发件人。密码应由部署平台的 secret 注入，不要提交真实值。
MCWEB_SMTP_ADDRESS=smtp.example.com
MCWEB_SMTP_PORT=587
MCWEB_SMTP_AUTHENTICATION=plain
MCWEB_SMTP_USERNAME=replace_with_smtp_username
MCWEB_SMTP_PASSWORD=replace_with_smtp_password
MCWEB_SMTP_TLS=starttls
MCWEB_SMTP_OPEN_TIMEOUT=5
MCWEB_SMTP_READ_TIMEOUT=10
MCWEB_MAIL_FROM="McWeb <noreply@example.com>"

# 私有 S3 兼容对象存储。AWS IAM role 场景可同时省略两个静态凭证。
MCWEB_ACTIVE_STORAGE_SERVICE=private_s3
MCWEB_S3_BUCKET=replace_with_private_bucket
MCWEB_S3_REGION=us-east-1
MCWEB_S3_ACCESS_KEY_ID=replace_with_access_key
MCWEB_S3_SECRET_ACCESS_KEY=replace_with_secret_key
# MinIO、R2 等兼容服务填写 HTTPS endpoint；AWS S3 留空。
MCWEB_S3_ENDPOINT=
MCWEB_S3_FORCE_PATH_STYLE=0

# 独立、私有且不可公开访问的对象备份桶。不得与 MCWEB_S3_BUCKET 相同。
# AWS IAM role 场景可省略静态凭证；MinIO/R2 等需配置对应 HTTPS endpoint。
MCWEB_BACKUP_S3_BUCKET=replace_with_backup_bucket
MCWEB_BACKUP_S3_REGION=us-east-1
MCWEB_BACKUP_S3_ACCESS_KEY_ID=replace_with_backup_access_key
MCWEB_BACKUP_S3_SECRET_ACCESS_KEY=replace_with_backup_secret_key
MCWEB_BACKUP_S3_ENDPOINT=
MCWEB_BACKUP_S3_FORCE_PATH_STYLE=0
MCWEB_BACKUP_S3_PREFIX=mcweb-backups

# 附件恶意内容扫描（clamav_command 或 clamd_tcp；生产未配置时上传 fail-closed）。
MCWEB_ATTACHMENT_SCANNER=clamav_command
MCWEB_CLAMAV_COMMAND=/usr/bin/clamscan
# 使用 clamd_tcp 时改为 clamd 的私网地址；禁止暴露到公网。
MCWEB_CLAMD_HOST=127.0.0.1
MCWEB_CLAMD_PORT=3310

MCWEB_TEMPLATE_DIR=/var/lib/mcweb/templates
MCWEB_BACKUP_DIR=/var/backups/mcweb
# 每日 systemd 备份保留策略：同时满足超过天数且不属于最新代数时才会清理。
MCWEB_BACKUP_RETENTION_DAYS=30
MCWEB_BACKUP_RETENTION_COUNT=7
# Sidekiq 任务队列（生产环境必需，开发环境可写在 config/local.yml）
REDIS_URL=redis://127.0.0.1:6379/0
# Sidekiq worker 并发（默认 5，见 config/sidekiq.yml）
JOB_CONCURRENCY=5

# 论坛邮件回帖（Action Mailbox relay ingress）
# 该域名需由邮件供应商或 MTA 转发到 Rails relay ingress。
MCWEB_INBOUND_EMAIL_DOMAIN=replies.example.com
MCWEB_ACTION_MAILBOX_INGRESS=relay
RAILS_INBOUND_EMAIL_PASSWORD=replace_with_a_random_secret
