POSTGRES_USER=mcweb
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_DB=mcweb_production
MCWEB_WEB_PORT=3000
SECRET_KEY_BASE=replace_with_rails_secret
LOCKBOX_MASTER_KEY=replace_with_64_hex_characters
RAILS_INBOUND_EMAIL_PASSWORD=replace_with_a_random_secret_of_at_least_32_bytes
# Developer Mode 默认关闭。受控应急调试时才可改为 1，并取消下一行注释；
# production 确认值必须逐字匹配，普通 true/yes 会使容器启动失败。
MCWEB_DEVELOPER_MODE=0
# MCWEB_DEVELOPER_MODE_PRODUCTION_CONFIRMATION=I_ACCEPT_UNSAFE_DEVELOPER_MODE

# Public domain for nginx + Let's Encrypt (certbot). Required before running
# ./nginx/init-letsencrypt.sh. Must already resolve to this host.
MCWEB_DOMAIN=example.com
MCWEB_PUBLIC_URL=https://example.com
MCWEB_ALLOWED_HOSTS=example.com
# Docker bridge networks normally use 172.16.0.0/12. Narrow this if a fixed
# network CIDR is configured for the stack.
MCWEB_TRUSTED_PROXIES=172.16.0.0/12
# certbot registration / expiry-notice email. Leave empty to register without one.
MCWEB_ACME_EMAIL=admin@example.com
# Set to 1 to use Let's Encrypt's staging environment while testing (avoids rate limits).
CERTBOT_STAGING=0

# SMTP (replace all placeholders; do not commit the populated .env file).
MCWEB_SMTP_ADDRESS=smtp.example.com
MCWEB_SMTP_PORT=587
MCWEB_SMTP_AUTHENTICATION=plain
MCWEB_SMTP_USERNAME=replace_with_smtp_username
MCWEB_SMTP_PASSWORD=replace_with_smtp_password
MCWEB_SMTP_TLS=starttls
MCWEB_MAIL_FROM="McWeb <noreply@example.com>"

# Private S3-compatible object storage.
MCWEB_S3_BUCKET=replace_with_private_bucket
MCWEB_S3_REGION=us-east-1
MCWEB_S3_ACCESS_KEY_ID=replace_with_access_key
MCWEB_S3_SECRET_ACCESS_KEY=replace_with_secret_key
MCWEB_S3_ENDPOINT=
MCWEB_S3_FORCE_PATH_STYLE=0

# Attachments fail closed while disabled. Point this at a private clamd service
# before enabling downloadable forum attachments.
MCWEB_ATTACHMENT_SCANNER=disabled
MCWEB_CLAMD_HOST=clamd.internal
MCWEB_CLAMD_PORT=3310
