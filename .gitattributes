# See https://git-scm.com/docs/gitattributes for more about git attribute files.

# Mark the database schema as having been generated.
db/schema.rb linguist-generated

# Mark any vendored files as having been vendored.
vendor/* linguist-vendored
config/credentials/*.yml.enc diff=rails_credentials
config/credentials.yml.enc diff=rails_credentials

# Normalize line endings: auto-detect text files, store LF in repo, check out LF.
# Global rule first; more specific rules below override it.
* text=auto eol=lf

# Windows batch scripts must stay CRLF to run reliably (e.g. connector/gradlew.bat).
*.bat text eol=crlf
*.cmd text eol=crlf

gradlew text eol=lf
*.sh text eol=lf
