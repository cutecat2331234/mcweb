#!/usr/bin/env bash
set -Eeuo pipefail

umask 077

CONFIG_FILE="${MCWEB_CONFIG_FILE:-/etc/mcweb/mcweb.env}"
APP_ROOT="${MCWEB_APPLICATION_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
STAGING_PATH=""
BACKUP_STAGE="startup"
BACKUP_ERROR_CODE="backup_failed"
BACKUP_REPORT_ENABLED=0
BACKUP_STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
BACKUP_EVIDENCE_DIR="${MCWEB_BACKUP_EVIDENCE_DIR:-}"
BACKUP_ID_FOR_REPORT=""
BACKUP_STORAGE_MODE_FOR_REPORT="unknown"

die() {
  echo "Backup failed: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command is not available: $1"
}

report_failed_backup() {
  if [[ -n "${STAGING_PATH}" ]]; then
    echo "Backup staging directory retained for inspection: ${STAGING_PATH}" >&2
  fi
}

initialize_backup_evidence() {
  local backup_dir="$1"
  local canonical_evidence

  BACKUP_ID_FOR_REPORT="$2"
  if [[ -z "${BACKUP_EVIDENCE_DIR}" ]]; then
    BACKUP_EVIDENCE_DIR="${backup_dir}/.backup-evidence"
  fi
  [[ "${BACKUP_EVIDENCE_DIR}" = /* ]] || die "backup evidence directory must be absolute"
  canonical_evidence="$(realpath --canonicalize-missing -- "${BACKUP_EVIDENCE_DIR}")"
  [[ "${BACKUP_EVIDENCE_DIR}" == "${canonical_evidence}" ]] ||
    die "backup evidence directory must be canonical"
  case "${canonical_evidence}" in
    /|/etc|/opt|/usr|/var|/var/backups)
      die "backup evidence directory is too broad"
      ;;
  esac
  [[ ! -L "${BACKUP_EVIDENCE_DIR}" ]] ||
    die "backup evidence directory must not be a symbolic link"
  case "${canonical_evidence}/" in
    "${backup_dir}/${BACKUP_ID_FOR_REPORT}/"*)
      die "backup evidence directory must not be inside the immutable backup target"
      ;;
  esac

  mkdir -p "${BACKUP_EVIDENCE_DIR}"
  chmod 700 "${BACKUP_EVIDENCE_DIR}"
  BACKUP_REPORT_ENABLED=1
  trap finalize_backup EXIT
}

write_backup_report() {
  local status="$1"
  local outcome error_code error_class finished_at report_name report_tmp
  local manifest_sha256=""

  [[ "${BACKUP_REPORT_ENABLED}" == "1" ]] || return 0
  outcome="failure"
  error_code="${BACKUP_ERROR_CODE:-backup_failed}"
  error_class="process_exit"
  if [[ "${status}" == "0" ]]; then
    outcome="success"
    error_code=""
    error_class=""
  fi
  if [[ "${outcome}" == "success" && -f "${MCWEB_BACKUP_DIR:-/var/backups/mcweb}/${BACKUP_ID_FOR_REPORT}/backup-manifest.json" ]]; then
    manifest_sha256="$(
      sha256sum "${MCWEB_BACKUP_DIR:-/var/backups/mcweb}/${BACKUP_ID_FOR_REPORT}/backup-manifest.json" |
        awk '{print $1}'
    )" || return 1
    [[ "${manifest_sha256}" =~ ^[0-9a-f]{64}$ ]] || return 1
  fi
  finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  report_name="backup-${BACKUP_ID_FOR_REPORT}-$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
  report_tmp="$(mktemp "${BACKUP_EVIDENCE_DIR}/.backup-report.XXXXXX")" || return 1

  REPORT_OUTCOME="${outcome}" \
  REPORT_STAGE="${BACKUP_STAGE}" \
  REPORT_ERROR_CODE="${error_code}" \
  REPORT_ERROR_CLASS="${error_class}" \
  REPORT_BACKUP_ID="${BACKUP_ID_FOR_REPORT}" \
  REPORT_STORAGE_MODE="${BACKUP_STORAGE_MODE_FOR_REPORT}" \
  REPORT_MANIFEST_SHA256="${manifest_sha256}" \
  REPORT_STARTED_AT="${BACKUP_STARTED_AT}" \
  REPORT_FINISHED_AT="${finished_at}" \
    ruby -rjson -e '
      payload = {
        format: "mcweb-backup-run-evidence-v1",
        outcome: ENV.fetch("REPORT_OUTCOME"),
        stage: ENV.fetch("REPORT_STAGE"),
        error_code: ENV.fetch("REPORT_ERROR_CODE").then { |value| value.empty? ? nil : value },
        error_class: ENV.fetch("REPORT_ERROR_CLASS").then { |value| value.empty? ? nil : value },
        backup_id: ENV.fetch("REPORT_BACKUP_ID"),
        storage_mode: ENV.fetch("REPORT_STORAGE_MODE"),
        manifest_sha256: ENV.fetch("REPORT_MANIFEST_SHA256").then { |value| value.empty? ? nil : value },
        started_at: ENV.fetch("REPORT_STARTED_AT"),
        finished_at: ENV.fetch("REPORT_FINISHED_AT")
      }
      File.binwrite(ARGV.fetch(0), JSON.pretty_generate(payload) << "\n")
    ' "${report_tmp}" || {
      rm --force -- "${report_tmp}"
      return 1
    }
  chmod 600 "${report_tmp}" || {
    rm --force -- "${report_tmp}"
    return 1
  }
  mv --no-clobber --no-target-directory \
    "${report_tmp}" "${BACKUP_EVIDENCE_DIR}/${report_name}" || {
      rm --force -- "${report_tmp}"
      return 1
    }
}

finalize_backup() {
  local status=$?
  local report_status=0

  trap - EXIT
  report_failed_backup || report_status=$?
  write_backup_report "${status}" || report_status=$?
  if [[ "${status}" == "0" && "${report_status}" != "0" ]]; then
    echo "Backup failed: backup evidence could not be persisted" >&2
    exit "${report_status}"
  fi
  if [[ "${report_status}" != "0" ]]; then
    echo "Backup evidence persistence also failed" >&2
  fi
  exit "${status}"
}

load_runtime_environment() {
  if [[ -r "${CONFIG_FILE}" ]]; then
    # The production environment file is root-controlled shell input. Loading it
    # supplies runtime credentials without copying or printing them.
    set -a
    # shellcheck disable=SC1090
    source "${CONFIG_FILE}"
    set +a
  fi
}

write_safe_configuration() {
  local output="$1"
  local key value line
  local -a safe_keys=(
    RAILS_ENV
    RAILS_SERVE_STATIC_FILES
    BUNDLE_DEPLOYMENT
    BUNDLE_WITHOUT
    MCWEB_DATABASE_USERNAME
    MCWEB_DATABASE_NAME
    MCWEB_DATABASE_HOST
    MCWEB_DATABASE_PORT
    MCWEB_PUBLIC_URL
    MCWEB_ALLOWED_HOSTS
    MCWEB_TRUSTED_PROXIES
    MCWEB_BIND
    MCWEB_HOST
    MCWEB_SMTP_ADDRESS
    MCWEB_SMTP_PORT
    MCWEB_SMTP_AUTHENTICATION
    MCWEB_SMTP_TLS
    MCWEB_SMTP_OPEN_TIMEOUT
    MCWEB_SMTP_READ_TIMEOUT
    MCWEB_MAIL_FROM
    MCWEB_ACTIVE_STORAGE_SERVICE
    MCWEB_S3_BUCKET
    MCWEB_S3_REGION
    MCWEB_S3_ENDPOINT
    MCWEB_S3_FORCE_PATH_STYLE
    MCWEB_BACKUP_S3_BUCKET
    MCWEB_BACKUP_S3_REGION
    MCWEB_BACKUP_S3_ENDPOINT
    MCWEB_BACKUP_S3_FORCE_PATH_STYLE
    MCWEB_BACKUP_S3_PREFIX
    MCWEB_BACKUP_RETENTION_DAYS
    MCWEB_BACKUP_RETENTION_COUNT
    MCWEB_ATTACHMENT_SCANNER
    MCWEB_CLAMAV_COMMAND
    MCWEB_CLAMD_HOST
    MCWEB_CLAMD_PORT
    MCWEB_TEMPLATE_DIR
    MCWEB_BACKUP_DIR
    JOB_CONCURRENCY
  )

  : > "${output}"
  for key in "${safe_keys[@]}"; do
    if [[ -v "${key}" ]]; then
      value="${!key}"
      [[ "${value}" != *$'\n'* && "${value}" != *$'\r'* ]] ||
        die "refusing multiline value in non-secret configuration: ${key}"
      if [[ ( "${key}" == "MCWEB_S3_ENDPOINT" || "${key}" == "MCWEB_BACKUP_S3_ENDPOINT" ) &&
            -n "${value}" &&
            ! "${value}" =~ ^https://[A-Za-z0-9._:\[\]-]+/?$ ]]; then
        die "refusing a credential-bearing or invalid S3 endpoint in non-secret configuration"
      fi
      printf '%s=%s\n' "${key}" "${value}" >> "${output}"
      continue
    fi

    [[ -r "${CONFIG_FILE}" ]] || continue
    if line="$(grep -m 1 -E "^${key}=" "${CONFIG_FILE}")"; then
      printf '%s\n' "${line}" >> "${output}"
    fi
  done
}

write_secret_configuration_artifact() {
  local target="$1"
  local recipient="${MCWEB_BACKUP_GPG_RECIPIENT:-}"
  local secret_reference="${MCWEB_SECRET_BACKUP_REFERENCE:-}"

  if [[ -r "${CONFIG_FILE}" && -n "${recipient}" ]]; then
    require_command gpg
    gpg --batch --yes --trust-model always \
      --output "${target}/mcweb.env.gpg" \
      --encrypt --recipient "${recipient}" "${CONFIG_FILE}"
    gpg --batch --list-packets "${target}/mcweb.env.gpg" >/dev/null
    SECRET_ARTIFACT="mcweb.env.gpg"
    SECRET_ARTIFACT_KIND="openpgp"
    return
  fi

  if [[ -n "${secret_reference}" ]]; then
    [[ "${secret_reference}" =~ ^[a-z][a-z0-9+.-]*://[A-Za-z0-9._/-]+/versions/[A-Za-z0-9._-]+$ &&
       ! "${secret_reference}" =~ /versions/(latest|current|active)$ ]] ||
      die "MCWEB_SECRET_BACKUP_REFERENCE must be a non-secret URI ending in /versions/IMMUTABLE_ID"
    printf '%s\n' "${secret_reference}" > "${target}/secret-config.reference"
    SECRET_ARTIFACT="secret-config.reference"
    SECRET_ARTIFACT_KIND="external_reference"
    return
  fi

  if [[ -r "${CONFIG_FILE}" ]]; then
    die "set MCWEB_BACKUP_GPG_RECIPIENT or MCWEB_SECRET_BACKUP_REFERENCE; plaintext mcweb.env is never backed up"
  fi

  die "no encrypted configuration source or immutable secret-manager reference was supplied"
}

write_object_storage_inventory() {
  local output="$1"
  local backup_id="$2"

  RAILS_ENV="${RAILS_ENV:-production}" \
    bundle exec ruby scripts/object-storage-archive.rb snapshot \
      --inventory "${output}" \
      --backup-id "${backup_id}"
}

write_local_storage_inventory() {
  local storage_root="$1"
  local target="$2"
  local snapshot unsafe_entry file_list

  [[ "${storage_root}" = /* ]] || die "MCWEB_LOCAL_STORAGE_ROOT must be an absolute path"
  [[ -d "${storage_root}" ]] || die "local Active Storage root does not exist: ${storage_root}"
  unsafe_entry="$(
    find "${storage_root}" \
      \( -type l -o \( ! -type d ! -type f \) \) \
      -print -quit
  )"
  [[ -z "${unsafe_entry}" ]] ||
    die "local Active Storage contains a symbolic link or special file"

  tar --create --gzip --hard-dereference \
    --owner=0 --group=0 \
    --file "${target}/active_storage.tar.gz" \
    --directory "${storage_root}" .
  tar --list --gzip --file "${target}/active_storage.tar.gz" >/dev/null
  if ! tar --list --verbose --gzip --file "${target}/active_storage.tar.gz" |
      awk '
        substr($0, 1, 1) != "-" && substr($0, 1, 1) != "d" { unsafe = 1 }
        END { exit unsafe ? 1 : 0 }
      '
  then
    die "local Active Storage archive contains a link or special file"
  fi
  if ! tar --list --gzip --file "${target}/active_storage.tar.gz" |
      awk '
        /^\/|(^|\/)\.\.(\/|$)/ || $0 !~ /^[A-Za-z0-9._\/-]+$/ { unsafe = 1 }
        END { exit unsafe ? 1 : 0 }
      '
  then
    die "local Active Storage archive contains an unsupported path"
  fi

  snapshot="$(mktemp -d "${target}/.active-storage-snapshot.XXXXXX")"
  tar --extract --gzip --no-same-owner --no-same-permissions \
    --file "${target}/active_storage.tar.gz" \
    --directory "${snapshot}"
  unsafe_entry="$(
    find "${snapshot}" \
      \( -type l -o \( ! -type d ! -type f \) \) \
      -print -quit
  )"
  [[ -z "${unsafe_entry}" ]] ||
    die "local Active Storage snapshot contains a symbolic link or special file"

  file_list="${target}/.active-storage-files"
  [[ ! -e "${file_list}" ]] || die "local Active Storage helper path already exists"
  (
    cd "${snapshot}"
    find . -type f -print0 | sort -z
  ) > "${file_list}" ||
    die "could not enumerate the local Active Storage snapshot"

  (
    cd "${snapshot}"
    while IFS= read -r -d '' file; do
      [[ "${file#./}" =~ ^[A-Za-z0-9._/-]+$ &&
         "${file#./}" != ".." &&
         "${file#./}" != ../* &&
         "${file#./}" != */../* &&
         "${file#./}" != */.. ]] ||
        die "local Active Storage contains an unsupported path"
      sha256sum "${file#./}"
    done < "${file_list}"
  ) > "${target}/active_storage_files.sha256"
  rm --force -- "${file_list}"
  rm --recursive --force --one-file-system -- "${snapshot}"
}

write_backup_manifest() {
  local target="$1"
  local backup_id="$2"
  local created_at="$3"
  local storage_mode="$4"
  local storage_inventory="$5"
  local storage_archive="$6"
  local source_bucket="$7"
  local backup_bucket="$8"

  MANIFEST_TARGET="${target}/backup-manifest.json" \
  MANIFEST_BACKUP_ID="${backup_id}" \
  MANIFEST_CREATED_AT="${created_at}" \
  MANIFEST_STORAGE_MODE="${storage_mode}" \
  MANIFEST_STORAGE_INVENTORY="${storage_inventory}" \
  MANIFEST_STORAGE_ARCHIVE="${storage_archive}" \
  MANIFEST_SOURCE_BUCKET="${source_bucket}" \
  MANIFEST_BACKUP_BUCKET="${backup_bucket}" \
  MANIFEST_SECRET_ARTIFACT="${SECRET_ARTIFACT}" \
  MANIFEST_SECRET_KIND="${SECRET_ARTIFACT_KIND}" \
    ruby -rjson -e '
      mode = ENV.fetch("MANIFEST_STORAGE_MODE")
      archive = ENV.fetch("MANIFEST_STORAGE_ARCHIVE")
      remote_snapshot = if mode == "private_s3"
        {
          provider: "s3",
          inventory_format: "mcweb-object-snapshot-v1",
          source_bucket: ENV.fetch("MANIFEST_SOURCE_BUCKET"),
          backup_bucket: ENV.fetch("MANIFEST_BACKUP_BUCKET")
        }
      end
      payload = {
        format: "mcweb-backup-v2",
        backup_id: ENV.fetch("MANIFEST_BACKUP_ID"),
        created_at: ENV.fetch("MANIFEST_CREATED_AT"),
        database: { path: "database.dump", format: "postgresql-custom" },
        active_storage: {
          mode:,
          inventory: ENV.fetch("MANIFEST_STORAGE_INVENTORY"),
          archive: archive == "null" ? nil : archive,
          remote_snapshot:
        },
        configuration: {
          non_secret: "configuration.env",
          secret_artifact: ENV.fetch("MANIFEST_SECRET_ARTIFACT"),
          secret_artifact_kind: ENV.fetch("MANIFEST_SECRET_KIND")
        }
      }
      File.binwrite(ENV.fetch("MANIFEST_TARGET"), JSON.pretty_generate(payload) << "\n")
    '
}

write_checksums() {
  local target="$1"
  local file_list="${target}/.checksum-files"

  [[ ! -e "${file_list}" ]] || die "backup checksum helper path already exists"
  (
    cd "${target}"
    find . -type f ! -name SHA256SUMS ! -name .checksum-files -print0 |
      sort -z
  ) > "${file_list}" || die "could not enumerate backup artifacts"

  (
    cd "${target}"
    while IFS= read -r -d '' file; do
      sha256sum "${file#./}"
    done < "${file_list}"
  ) > "${target}/SHA256SUMS"
  rm --force -- "${file_list}"

  (
    cd "${target}"
    sha256sum --check --strict SHA256SUMS >/dev/null
  )
}

run_pg_dump() {
  if [[ -n "${DATABASE_URL:-}" ]]; then
    PGDATABASE="${DATABASE_URL}" DATABASE_URL="" pg_dump "$@"
  else
    PGHOST="${MCWEB_DATABASE_HOST:-${PGHOST:-}}" \
    PGPORT="${MCWEB_DATABASE_PORT:-${PGPORT:-}}" \
    PGUSER="${MCWEB_DATABASE_USERNAME:-${PGUSER:-}}" \
    PGPASSWORD="${MCWEB_DATABASE_PASSWORD:-${PGPASSWORD:-}}" \
    PGDATABASE="${MCWEB_DATABASE_NAME:-${PGDATABASE:-mcweb_production}}" \
      pg_dump "$@"
  fi
}

main() {
  require_command pg_dump
  require_command pg_restore
  require_command sha256sum
  require_command find
  require_command sort
  require_command tar
  require_command awk
  require_command mktemp
  require_command rm
  require_command mv
  require_command ruby
  require_command bundle
  require_command realpath
  require_command grep

  load_runtime_environment
  cd "${APP_ROOT}"

  local backup_dir="${MCWEB_BACKUP_DIR:-/var/backups/mcweb}"
  local backup_id="${MCWEB_BACKUP_ID:-$(date -u +%Y%m%dT%H%M%SZ)}"
  local created_at
  local target staging storage_mode storage_root
  local storage_inventory storage_archive latest_tmp canonical_backup_dir
  local canonical_storage_root source_bucket backup_bucket

  [[ "${backup_id}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
    die "MCWEB_BACKUP_ID contains unsupported characters"
  [[ "${backup_dir}" = /* ]] || die "MCWEB_BACKUP_DIR must be an absolute path"
  canonical_backup_dir="$(realpath --canonicalize-missing -- "${backup_dir}")"
  [[ "${backup_dir}" == "${canonical_backup_dir}" ]] ||
    die "MCWEB_BACKUP_DIR must be a canonical path"
  case "${canonical_backup_dir}" in
    /|/etc|/opt|/usr|/var|/var/backups)
      die "MCWEB_BACKUP_DIR is too broad"
      ;;
  esac
  [[ ! -L "${backup_dir}" ]] || die "MCWEB_BACKUP_DIR must not be a symbolic link"

  storage_mode="${MCWEB_ACTIVE_STORAGE_SERVICE:-private_s3}"
  BACKUP_STORAGE_MODE_FOR_REPORT="${storage_mode}"
  case "${storage_mode}" in
    private_s3)
      source_bucket="${MCWEB_S3_BUCKET:-}"
      backup_bucket="${MCWEB_BACKUP_S3_BUCKET:-}"
      [[ "${source_bucket}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
        die "MCWEB_S3_BUCKET is missing or invalid"
      [[ "${backup_bucket}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] ||
        die "MCWEB_BACKUP_S3_BUCKET is missing or invalid"
      [[ "${source_bucket}" != "${backup_bucket}" ]] ||
        die "MCWEB_BACKUP_S3_BUCKET must differ from MCWEB_S3_BUCKET"
      ;;
    local)
      source_bucket=""
      backup_bucket=""
      storage_root="${MCWEB_LOCAL_STORAGE_ROOT:-}"
      [[ -n "${storage_root}" ]] ||
        die "MCWEB_LOCAL_STORAGE_ROOT is required when Active Storage uses local disk"
      [[ "${storage_root}" = /* ]] ||
        die "MCWEB_LOCAL_STORAGE_ROOT must be an absolute path"
      [[ -d "${storage_root}" && ! -L "${storage_root}" ]] ||
        die "MCWEB_LOCAL_STORAGE_ROOT must be a real directory"
      canonical_storage_root="$(realpath --canonicalize-existing -- "${storage_root}")"
      [[ "${storage_root}" == "${canonical_storage_root}" ]] ||
        die "MCWEB_LOCAL_STORAGE_ROOT must be a canonical path"
      case "${canonical_backup_dir}/" in
        "${canonical_storage_root}/"*)
          die "MCWEB_BACKUP_DIR must not be inside MCWEB_LOCAL_STORAGE_ROOT"
          ;;
      esac
      case "${canonical_storage_root}/" in
        "${canonical_backup_dir}/"*)
          die "MCWEB_LOCAL_STORAGE_ROOT must not be inside MCWEB_BACKUP_DIR"
          ;;
      esac
      storage_root="${canonical_storage_root}"
      ;;
    *)
      die "unsupported MCWEB_ACTIVE_STORAGE_SERVICE: ${storage_mode}"
      ;;
  esac

  created_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  target="${backup_dir}/${backup_id}"
  staging="${backup_dir}/.${backup_id}.partial.$$"
  [[ ! -e "${target}" && ! -e "${staging}" ]] ||
    die "backup target already exists: ${target}"

  mkdir -p "${backup_dir}"
  chmod 700 "${backup_dir}"
  initialize_backup_evidence "${backup_dir}" "${backup_id}"
  mkdir "${staging}"
  STAGING_PATH="${staging}"
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  BACKUP_STAGE="database_dump"
  run_pg_dump --format=custom --no-owner --no-privileges \
    --file="${staging}/database.dump"
  pg_restore --list "${staging}/database.dump" >/dev/null

  BACKUP_STAGE="configuration_snapshot"
  write_safe_configuration "${staging}/configuration.env"
  SECRET_ARTIFACT=""
  SECRET_ARTIFACT_KIND=""
  write_secret_configuration_artifact "${staging}"

  case "${storage_mode}" in
    private_s3)
      BACKUP_STAGE="object_snapshot"
      write_object_storage_inventory "${staging}/active_storage_objects.ndjson" "${backup_id}"
      storage_inventory="active_storage_objects.ndjson"
      storage_archive="null"
      ;;
    local)
      BACKUP_STAGE="local_storage_snapshot"
      write_local_storage_inventory "${storage_root}" "${staging}"
      storage_inventory="active_storage_files.sha256"
      storage_archive="active_storage.tar.gz"
      ;;
  esac

  BACKUP_STAGE="manifest_write"
  write_backup_manifest \
    "${staging}" "${backup_id}" "${created_at}" \
    "${storage_mode}" "${storage_inventory}" "${storage_archive}" \
    "${source_bucket}" "${backup_bucket}"
  BACKUP_STAGE="artifact_checksums"
  write_checksums "${staging}"

  chmod 700 "${staging}"
  find "${staging}" -type f -exec chmod 600 {} +
  BACKUP_STAGE="publication"
  mv --no-clobber --no-target-directory "${staging}" "${target}"
  [[ ! -e "${staging}" ]] ||
    die "backup target appeared during publication: ${target}"

  latest_tmp="${backup_dir}/.latest.$$"
  printf '%s\n' "${target}" > "${latest_tmp}"
  chmod 600 "${latest_tmp}"
  mv --no-target-directory "${latest_tmp}" "${backup_dir}/latest"
  trap - INT TERM HUP
  STAGING_PATH=""
  BACKUP_STAGE="completed"
  BACKUP_ERROR_CODE=""

  echo "Backup completed and verified: ${target}"
}

main "$@"
