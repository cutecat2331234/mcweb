<p><%= t("mcweb.mail.greeting_formal", username: @user.display_name.presence || @user.username) %></p>

<p><%= t("mcweb.mail.identity.password_changed.intro") %></p>

<p><%= t("mcweb.mail.identity.password_changed.changed_at", at: l(@changed_at, format: :long)) %></p>

<p><%= t("mcweb.mail.identity.password_changed.revoked_sessions", count: @revoked_session_count) %></p>

<p><%= link_to t("mcweb.mail.identity.password_changed.review_security"), @security_url %></p>

<p><%= t("mcweb.mail.identity.password_changed.not_you") %> <%= link_to t("mcweb.mail.identity.password_changed.reset_password"), @reset_url %></p>
