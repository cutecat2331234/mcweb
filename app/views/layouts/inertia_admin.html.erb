<!DOCTYPE html>
<html
  lang="<%= I18n.locale %>"
  data-developer-mode="<%= Mcweb::DeveloperMode.enabled? %>"
  data-mcweb-application="<%= frontend_application_id %>"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title inertia><%= "[DEV] " if Mcweb::DeveloperMode.enabled? %>Mcweb Admin</title>
    <% if Mcweb::DeveloperMode.enabled? %>
      <meta name="robots" content="noindex, nofollow">
    <% end %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/admin_pwa_guard" %>
    <%= render "shared/tech_fingerprint" %>
    <%= render "shared/theme_bootstrap" %>
    <%= vite_typescript_tag frontend_application_entrypoint %>
    <%= inertia_ssr_head %>
  </head>
  <body class="mcweb-admin antialiased" data-mcweb-application="<%= frontend_application_id %>">
    <%= inertia_root %>
  </body>
</html>
