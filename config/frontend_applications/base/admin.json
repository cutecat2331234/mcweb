    {
      "kind": "download",
      "methods": ["GET", "HEAD"],
      "pattern": "/admin/store/orders/export",
      "priority": 9000
    },
    {
      "kind": "download",
      "methods": ["GET", "HEAD"],
      "pattern": "/admin/store/finance/exports/*/download",
      "priority": 9000
    },
    {
      "kind": "download",
      "methods": ["GET", "HEAD"],
      "pattern": "/admin/store/disputes/*/evidence/*/download",
      "priority": 9000
    },
    {
      "kind": "inertia_page",
      "methods": ["GET", "HEAD"],
      "pattern": "/admin",
      "priority": 500
    },
    {
      "kind": "inertia_page",
      "methods": ["GET", "HEAD"],
      "pattern": "/admin/**",
      "priority": 500
    },
    {
      "kind": "application_action",
      "methods": ["POST", "PUT", "PATCH", "DELETE"],
      "pattern": "/admin/**",
      "priority": 500
